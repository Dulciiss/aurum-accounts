{
  "name": "league-accounts",
  "version": "1.0.0",
  "description": "League of Legends Account Manager",
  "author": "Tu Nombre",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.league.accounts",
    "productName": "League Accounts",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.exe"
    }
  }
}