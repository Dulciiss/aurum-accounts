{
  "name": "league-accounts",
  "version": "1.0.0",
  "description": "League of Legends Account Manager",
  "author": "Dulciiss",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:all": "electron-builder -w -m -l"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.league.accounts",
    "productName": "League Accounts",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-Setup.exe"
    },
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "logo.svg",
      "icon.ico",
      "package.json",
      "css/**/*",
      "js/**/*"
    ]
  }
}